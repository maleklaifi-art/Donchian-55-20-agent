# Binance SPOT TESTNET credentials only.
BINANCE_TESTNET_API_KEY=replace_with_testnet_key
BINANCE_TESTNET_API_SECRET=replace_with_testnet_secret

# Protects the web dashboard.
DASHBOARD_PASSWORD=replace_with_a_long_password

# Safer default: cloud service starts but new entries stay paused until you press START.
AUTO_START_NEW_TRADES=false
DATA_DIR=/data
PORT=8080
